+
+uint16_t cpu_pc(void)
+{
+	return m_pc;
+}
+
+int cpu_halted(void)
+{
+	return (REG_PCON & HALT_MODE) ? 1 : 0;
+}
+
+uint8_t cpu_acc(void)
+{
+	return REG_A;
+}
+
+uint8_t cpu_ram(int bank, uint16_t addr)
+{
+	return m_mram[(bank & 1) * 0x100 + (addr & 0xff)];
+}
+
+/*----------------------
+ | cpu_set_pc
+ | Description: Moves the program counter, for the harness returning from a ROM entry it modelled.
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: m_pc
+ | Params: pc -- new program counter
+ | Returns: N/A
+ ----------------------*/
+void cpu_set_pc(uint16_t pc)
+{
+	m_pc = pc;
+}
+
+/*----------------------
+ | cpu_sfr / cpu_sfr_write
+ | Description: Reads an SFR's stored byte without side effects, or writes one through the core's own SFR write path.
+ | Author: suinevere
+ | Dependencies: mem_io_regs_w
+ | Globals: m_sfr
+ | Params: offset -- SFR offset 0x00-0x7F; data -- byte to write
+ | Returns: cpu_sfr returns the stored byte
+ ----------------------*/
+uint8_t cpu_sfr(uint16_t offset)
+{
+	return m_sfr[offset & 0x7f];
+}
+
+void cpu_sfr_write(uint16_t offset, uint8_t data)
+{
+	mem_io_regs_w(offset & 0x7f, data);
+}
+
+/*----------------------
+ | cpu_ram_write / cpu_wram / cpu_xram
+ | Description: Writes a byte of a RAM bank, or reads a byte of the 512-byte work RAM or of the raw XRAM (192 screen bytes, then the icons).
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: m_mram, m_vtrbf, m_xram
+ | Params: bank -- RAM bank 0 or 1; addr -- address in the bank or WRAM; index -- XRAM byte 0-0xC5; data -- byte to write
+ | Returns: the byte read, or N/A
+ ----------------------*/
+void cpu_ram_write(int bank, uint16_t addr, uint8_t data)
+{
+	m_mram[(bank & 1) * 0x100 + (addr & 0xff)] = data;
+}
+
+uint8_t cpu_wram(uint16_t addr)
+{
+	return m_vtrbf[addr & 0x1ff];
+}
+
+uint8_t cpu_xram(uint16_t index)
+{
+	return index < sizeof m_xram ? m_xram[index] : 0;
+}
+
+/*----------------------
+ | cpu_irq_pending
+ | Description: Whether check_irqs would take a latched interrupt request now, by the same IE, priority and running-level rules.
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: m_irq_flag, m_irq_lev, m_sfr
+ | Params: N/A
+ | Returns: nonzero when such a request is latched
+ ----------------------*/
+int cpu_irq_pending(void)
+{
+	int irq = 0, priority = 0;
+	if (!(REG_IE & 0x01) && (m_irq_flag & 0x02))
+		irq = 1, priority = 2;
+	else if (!(REG_IE & 0x02) && (m_irq_flag & 0x04))
+		irq = 2, priority = 2;
+	else if ((REG_IE & 0x80) && ((REG_IP << 3) & m_irq_flag))
+		irq = 3, priority = 1;
+	else if ((REG_IE & 0x80) && (m_irq_flag & 0x7fe))
+		irq = 1, priority = 0;
+	if (irq && ((m_irq_lev & (1 << priority)) || (priority == 0 && (m_irq_lev & 0x06)) || (priority == 1 && (m_irq_lev & 0x04))))
+		irq = 0;
+	return irq != 0;
+}
+
+/*----------------------
+ | min_ticks
+ | Description: Keeps the smaller of a running minimum and a candidate tick count.
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: N/A
+ | Params: best -- running minimum; n -- candidate
+ | Returns: the smaller
+ ----------------------*/
+static uint32_t min_ticks(uint32_t best, uint32_t n)
+{
+	return n < best ? n : best;
+}
+
+/*----------------------
+ | prescaler_ticks
+ | Description: Clock ticks until the Timer 0 prescaler's nth overflow from its current count.
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: m_timer0_prescaler, m_sfr
+ | Params: n -- overflow count, at least 1
+ | Returns: clock ticks
+ ----------------------*/
+static uint32_t prescaler_ticks(uint32_t n)
+{
+	return (0x100u - m_timer0_prescaler) + (n - 1) * (0x100u - REG_T0PRR);
+}
+
+/*----------------------
+ | cpu_clock_ticks_to_event
+ | Description: Clock ticks until Timer 0 or Timer 1 next overflows, or with wake set until one raises an interrupt the CPU would take; 1 when the base timer runs off this clock.
+ | Author: suinevere
+ | Dependencies: prescaler_ticks, min_ticks
+ | Globals: m_sfr, m_timer0, m_timer1, m_timer0_prescaler
+ | Params: wake -- nonzero to count only interrupts with IE bit 7 set
+ | Returns: tick count, or CPU_NO_EVENT
+ ----------------------*/
+uint32_t cpu_clock_ticks_to_event(int wake)
+{
+	uint32_t best = CPU_NO_EVENT;
+	if (REG_ISL & 0x10)
+		return 1;
+	if (wake && !(REG_IE & 0x80))
+		return CPU_NO_EVENT;
+	if (REG_T0CNT & 0xc0)
+	{
+		if (REG_T0CNT & 0x20)
+		{
+			if ((REG_T0CNT & 0xc0) == 0xc0 && !(REG_T0CNT & 0x10) && (!wake || (REG_T0CNT & 0x04)))
+				best = min_ticks(best, prescaler_ticks(0x10000u - ((m_timer0[1] << 8) | m_timer0[0])));
+		}
+		else
+		{
+			if ((REG_T0CNT & 0x40) && !(REG_T0CNT & 0x10) && (!wake || (REG_T0CNT & 0x01)))
+				best = min_ticks(best, prescaler_ticks(0x100u - m_timer0[0]));
+			if ((REG_T0CNT & 0x80) && (!wake || (REG_T0CNT & 0x04)))
+				best = min_ticks(best, prescaler_ticks(0x100u - m_timer0[1]));
+		}
+	}
+	if (REG_T1CNT & 0xc0)
+	{
+		if (REG_T1CNT & 0x20)
+		{
+			if (REG_T1CNT & 0x40)
+			{
+				uint32_t inc = (REG_T1CNT & 0x80) ? 1 : 2;
+				uint32_t first = (0x100u - m_timer1[0] + inc - 1) / inc;
+				uint32_t period = (0x100u - REG_T1LR + inc - 1) / inc;
+				if (!wake)
+					best = min_ticks(best, first);
+				else if (REG_T1CNT & 0x05)
+					best = min_ticks(best, first + (0xffu - m_timer1[1]) * period);
+			}
+		}
+		else
+		{
+			if ((REG_T1CNT & 0x40) && (!wake || (REG_T1CNT & 0x01)))
+				best = min_ticks(best, 0x100u - m_timer1[0]);
+			if ((REG_T1CNT & 0x80) && (!wake || (REG_T1CNT & 0x04)))
+				best = min_ticks(best, 0x100u - m_timer1[1]);
+		}
+	}
+	return best;
+}
+
+/*----------------------
+ | cpu_clock_advance
+ | Description: Advances the Timer 0 prescaler and the running Timer 0 and Timer 1 counters by n clock ticks, which must end before cpu_clock_ticks_to_event(0).
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: m_sfr, m_timer0, m_timer1, m_timer0_prescaler
+ | Params: n -- clock ticks
+ | Returns: N/A
+ ----------------------*/
+void cpu_clock_advance(uint32_t n)
+{
+	uint32_t first = 0x100u - m_timer0_prescaler;
+	uint32_t period = 0x100u - REG_T0PRR;
+	uint32_t m = 0;
+	if (n < first)
+	{
+		m_timer0_prescaler = (uint8_t)(m_timer0_prescaler + n);
+	}
+	else
+	{
+		m = 1 + (n - first) / period;
+		m_timer0_prescaler = (uint8_t)(REG_T0PRR + (n - first) % period);
+	}
+	if (REG_T0CNT & 0xc0)
+	{
+		if (REG_T0CNT & 0x20)
+		{
+			if ((REG_T0CNT & 0xc0) == 0xc0 && !(REG_T0CNT & 0x10))
+			{
+				uint32_t t0 = ((m_timer0[1] << 8) | m_timer0[0]) + m;
+				m_timer0[0] = t0 & 0xff;
+				m_timer0[1] = (t0 >> 8) & 0xff;
+			}
+		}
+		else
+		{
+			if ((REG_T0CNT & 0x40) && !(REG_T0CNT & 0x10))
+				m_timer0[0] = (uint8_t)(m_timer0[0] + m);
+			if (REG_T0CNT & 0x80)
+				m_timer0[1] = (uint8_t)(m_timer0[1] + m);
+		}
+	}
+	if (REG_T1CNT & 0xc0)
+	{
+		if (REG_T1CNT & 0x20)
+		{
+			if (REG_T1CNT & 0x40)
+				m_timer1[0] = (uint8_t)(m_timer1[0] + n * ((REG_T1CNT & 0x80) ? 1 : 2));
+		}
+		else
+		{
+			if (REG_T1CNT & 0x40)
+				m_timer1[0] = (uint8_t)(m_timer1[0] + n);
+			if (REG_T1CNT & 0x80)
+				m_timer1[1] = (uint8_t)(m_timer1[1] + n);
+		}
+	}
+}
+
+/*----------------------
+ | cpu_base_ticks_to_event
+ | Description: Base timer ticks until one sets a clear flag or raises an interrupt, or with wake set until one raises an interrupt the CPU would take.
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: m_sfr, m_base_timer
+ | Params: wake -- nonzero to count only interrupts with IE bit 7 set
+ | Returns: tick count, or CPU_NO_EVENT
+ ----------------------*/
+uint32_t cpu_base_ticks_to_event(int wake)
+{
+	uint32_t l = m_base_timer[0], h = m_base_timer[1];
+	uint8_t flags = REG_BTCR;
+	if ((REG_ISL & 0x10) || !(REG_BTCR & 0x40) || (wake && !(REG_IE & 0x80)))
+		return CPU_NO_EVENT;
+	for (uint32_t i = 1; i <= 0x8000; i++)
+	{
+		uint32_t cl = l + 1, ch = h;
+		int bt1 = 0, hit = 0;
+		if ((REG_BTCR & 0x80) || (cl & 0x100))
+			ch++;
+		switch (REG_BTCR & 0x30)
+		{
+			case 0x00: bt1 = (cl & 0x20) != 0; break;
+			case 0x10: bt1 = (cl & 0x80) != 0; break;
+			case 0x20: bt1 = (ch & 0x01) != 0; break;
+			case 0x30: bt1 = (ch & 0x04) != 0; break;
+		}
+		if (ch & 0x40)
+			hit |= (REG_BTCR & 0x01) || (!wake && !(flags & 0x02));
+		if (bt1)
+			hit |= (REG_BTCR & 0x04) || (!wake && !(flags & 0x08));
+		if (hit)
+			return i;
+		if (ch & 0x40)
+			flags |= 0x02;
+		if (bt1)
+			flags |= 0x08;
+		l = cl & 0xff;
+		h = ch & 0x3f;
+	}
+	return CPU_NO_EVENT;
+}
+
+/*----------------------
+ | cpu_base_advance
+ | Description: Advances the base timer counter by n ticks, which must end before cpu_base_ticks_to_event(0).
+ | Author: suinevere
+ | Dependencies: N/A
+ | Globals: m_sfr, m_base_timer
+ | Params: n -- base timer ticks
+ | Returns: N/A
+ ----------------------*/
+void cpu_base_advance(uint32_t n)
+{
+	uint32_t total = m_base_timer[0] + n;
+	if ((REG_ISL & 0x10) || !(REG_BTCR & 0x40))
+		return;
+	m_base_timer[1] = (m_base_timer[1] + ((REG_BTCR & 0x80) ? n : (total >> 8))) & 0x3f;
+	m_base_timer[0] = total & 0xff;
+}
