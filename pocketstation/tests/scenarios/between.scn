# between.scn: events falling due while the program works between idles, shared by scenario_host and rt_test.
# Author: suinevere
# Each idle takes exactly one event, as vmu_idle does, however long the work before it runs. A sound end leaves the
# tick 74 counts away; RAM ops outlast that, then a 72-count sound still ends first. Later the work spans two events,
# which still come in two handler calls.
enable 0x2100
tick 1
sound 215 1
idle 1
ram_write 0x040 0x00
log_ram 0x040
ram_write 0x041 0x11
log_ram 0x041
ram_write 0x042 0x22
log_ram 0x042
ram_write 0x043 0x33
log_ram 0x043
ram_write 0x044 0x44
log_ram 0x044
ram_write 0x045 0x55
log_ram 0x045
ram_write 0x046 0x66
log_ram 0x046
ram_write 0x047 0x77
log_ram 0x047
ram_write 0x048 0x88
log_ram 0x048
ram_write 0x049 0x99
log_ram 0x049
ram_write 0x04A 0xAA
log_ram 0x04A
ram_write 0x04B 0xBB
log_ram 0x04B
sound 0 1
idle 2
sound 214 1
idle 1
sound 0 1
ram_write 0x140 0x00
log_ram 0x140
ram_write 0x141 0x1D
log_ram 0x141
ram_write 0x142 0x3A
log_ram 0x142
ram_write 0x143 0x57
log_ram 0x143
ram_write 0x144 0x74
log_ram 0x144
ram_write 0x145 0x91
log_ram 0x145
ram_write 0x146 0xAE
log_ram 0x146
ram_write 0x147 0xCB
log_ram 0x147
ram_write 0x148 0xE8
log_ram 0x148
ram_write 0x149 0x05
log_ram 0x149
ram_write 0x14A 0x22
log_ram 0x14A
ram_write 0x14B 0x3F
log_ram 0x14B
ram_write 0x14C 0x5C
log_ram 0x14C
ram_write 0x14D 0x79
log_ram 0x14D
ram_write 0x14E 0x96
log_ram 0x14E
ram_write 0x14F 0xB3
log_ram 0x14F
idle 2
