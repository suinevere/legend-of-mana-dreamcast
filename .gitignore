# Ignore the python virtual environment folder
.venv/

# Game data files placed in the disc folder cannot be committed due to copyright issues
disc/*

# Assembly output folder from splat
asm/

# Linker scripts and auto-generated undefined symbols/functions lists
linker/

# Build output folder
build/
output/

# Generated objdiff configuration and locally downloaded CLI binaries
/objdiff.json
/tools/objdiff/objdiff-cli*

# Local generated files for matching purposes
.matching/

# Ignore generated C files
src/unk*.c
src/overlays/*/unk*.c

# Generated data-initializer fragments (copyrighted values filled from disc)
*.gen.inc
src/overlays/*/gen/

tools/splat_ext/__pycache__/
tools/compressor/__pycache__/
__pycache__/

/assets/

# m2c context cache files
*.m2c

# Dreamcast build output
dreamcast/build/
dreamcast/build-test/
dreamcast/.verify/
dreamcast/gen/
dreamcast/cd/data/
dreamcast/*.elf
dreamcast/*.cdi

# Downloaded Flycast emulator used by the Dreamcast boot-check runner
tools/flycast/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# DuckStation audio dumps for test_sound.py stay local
reference/ps1/audio/*.wav
reference/ps1/audio/*.mp4

# PocketStation build output: listings, card images and traces derived from the disc
pocketstation/build/
