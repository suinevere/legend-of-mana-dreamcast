# New game path for the D2 captures; timings are vblanks at 60 Hz.
# Sound checks for test_sound.py before the title song: a 4 s streamed long voice, then a 3 s 1 kHz stream tone; neither step waits.
longvoice 4
wait 250
tone 1000 3
wait state 2
wait 600
capture title
press DOWN 6
wait 30
press CROSS 6
wait state 7
wait 240
capture overlay-cload
mash CIRCLE 30 state 2
wait 600
press UP 6
wait 30
press CROSS 6
wait 240
capture gname-select-character
press CROSS 6
wait 180
capture gname-select-weapon
press CROSS 6
wait state 3
wait 300
capture gname-name-entry
press CROSS 6
wait state 5
wait 180
capture wsel-room
press CROSS 6
wait 120
capture wsel-prompt
press CROSS 6
wait 120
capture wsel-cursor
press CROSS 6
wait 120
capture wsel-cursor-confirmed
mash CROSS 40 state 1
wait 10
capture wmap-loading
wait 395
capture wmap-mailbox
wait 45
capture wmap-mailbox-carried
wait 180
capture wmap-place-mailbox-prompt
press CROSS 6
wait 30
press CROSS 6
wait 220
capture wmap-land-flash
wait 230
capture wmap-home-rising
wait 120
capture wmap-home-dark
wait 140
capture wmap-board-home
mash CROSS 40 marker field scene 857
mash CROSS 40 marker field map 18
wait 240
press DOWN 120
press LEFT 120
capture field-home
open shop
wait 120
capture overlay-shop
mash CIRCLE 20 marker field modal 0
wait 60
open golem
wait 180
capture overlay-golem
mash START 20 marker field open 0
wait 60
open zukan
wait 180
capture overlay-zukan
mash START 20 marker field open 0
wait 60
open gosub
wait 180
capture overlay-gosub
mash CIRCLE 20 marker field modal 0
wait 60
open carda
wait 180
capture overlay-carda
mash CIRCLE 20 marker field modal 0
wait 60
open niki
wait 180
capture overlay-niki
mash CIRCLE 20 marker field modal 0
wait 60
open addhero
wait 180
capture overlay-addhero
mash CIRCLE 20 marker field modal 0
wait 60
scene 71 0
mash CROSS 40 marker field scene 71
wait 300
capture field-battle-scene
battle
wait 60
capture field-battle
mash CROSS 20 marker field battle 0
wait 120
capture field-battle-end
gameover
mash SELECT 3000 marker field gover 1
wait 300
capture overlay-gover
mash CROSS 30 state 1
wait 120
capture gover-return
